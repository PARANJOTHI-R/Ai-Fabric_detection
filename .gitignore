# ==============================================================================
# .gitignore — AI Fabric Defect Detection & Quality Inspection System
# ==============================================================================

# ── Python & Byte-compiled files ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.*

# ── Node.js & Frontend ────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.npm/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs, Editors & OS Files ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# ── Backups & Scratch Scripts ─────────────────────────────────────────────────
*.bak
backups/
.backup/
scratch/

# ── YOLO Dataset Caches ───────────────────────────────────────────────────────
*.cache
dataset/labels/*.cache

# ── Large Archives & Training Handoff Zips (> 100 MB) ─────────────────────────
*.zip
*.tar.gz
*.tgz
*.rar
fabric_training_handoff.zip

# ── Heavy Datasets & Prepared Splits (> 1 GB) ─────────────────────────────────
Fabric Defects Dataset/
Fabric Defect Dataset/
Fabric defects Images/
data_prepared_v1/
data_prepared_v1_revised/

# ── Training Runs, Experiment Logs & Intermediate Checkpoints ─────────────────
runs/
wandb/
results/
baseline_checkpoints/
*.onnx
*.keras
*.h5

# ── Model Weights ─────────────────────────────────────────────────────────────
# Ignore all model weight files in root and experimental directories
*.pt
*.pth

# Explicitly track the active production models in backend/models (total < 35 MB)
!backend/models/
!backend/models/*.pt
!backend/models/*.pth
!backend/models/*.json